# Defaults run fully offline with rule-based agents.
LLM_PROVIDER=local            # local | bedrock
LOG_LEVEL=INFO
# CHECKPOINT_DB=data/state/checkpoints.sqlite
# COMPLIANCE_POLICY_PATH=policies/compliance_policy.json

# AWS Bedrock (standard boto3 credential chain; prefer SSO profiles or IAM roles)
AWS_DEFAULT_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# LangSmith tracing (optional; requires requirements-cloud.txt)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-legal-workflow
